# Virtual Environments
venv/
.venv/
env/

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# Cartog cache & default outputs
.cartog/
cartog-out/

# Session scratch space (deleted at the end of every session)
.scratch/

# Adversarial conformance samples are committed as test fixtures.
# Keep generated outputs out of them.
samples/**/cartog-out/
samples/**/__pycache__/
samples/**/.pytest_cache/
samples/**/node_modules/

# Node
node_modules/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
